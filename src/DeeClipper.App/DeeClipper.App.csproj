<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DeeClipper</AssemblyName>
    <RootNamespace>DeeClipper.App</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeeClipper.Core\DeeClipper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico" Condition="Exists('Assets\app.ico')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\paused.ico" Condition="Exists('Assets\paused.ico')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateIconsIfMissing" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\app.ico')">
    <Message Importance="high" Text="Generating application icons using scripts/make-icons.ps1..." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\make-icons.ps1&quot;" Condition="'$(OS)' == 'Windows_NT'" />
  </Target>

</Project>
